# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://maqrivo:maqrivo@localhost:5432/maqrivo
SIGNUP_INVITE_CODE=change-me
BETTER_AUTH_SECRET=generate-a-long-random-string

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── AI provider (server-side only; never exposed to the browser) ────────────
AI_PROVIDER=zai
ZAI_API_KEY=
ZAI_TEXT_MODEL=glm-5.3
ZAI_VISION_MODEL=glm-5.3-flash
ZAI_BUDGET_MODEL=glm-4.7

# ── Integrations ────────────────────────────────────────────────────────────
# Polite access to Open Food Facts requires a real contact address.
OFF_USER_AGENT_EMAIL=
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
PHOTON_ENDPOINT=https://photon.komoot.io/api
# Retailer catalogue probing kill-switch (see docs/adr/0005)
CARREFOUR_CATALOGUE_ENABLED=true

# ── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_VOLUME_PATH=./uploads
